{
  "name": "continuity-studio",
  "private": true,
  "version": "2.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently --kill-others --names web,server \"npm:dev\" \"npm:server\"",
    "build": "tsc -b && npm run typecheck:server && vite build",
    "build:source": "npm run build && npm run package:source",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "package:source": "tsx scripts/package-source.ts",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@letta-ai/letta-agent-sdk": "^0.7.4",
    "@letta-ai/letta-client": "1.12.1",
    "hono": "^4.13.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "archiver": "^8.0.0",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
